# Local MongoDB, Docker MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/rum_core

# Optional: if Atlas fails with querySrv ECONNREFUSED on your network,
# set explicit DNS resolvers for this Node process. Otherwise leave this blank.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173
# Set NODE_ENV=production in your hosting environment when deploying.

# Set when the tracker is installed on another website. Use your public HTTPS API.
# VITE_PUBLIC_API_URL=https://monitor.example.com

# Only enable behind a trusted reverse proxy. Leave off on a directly exposed server.
TRUST_PROXY=false

# Enable only when direct access is blocked and Cloudflare supplies these headers.
TRUST_CLOUDFLARE=false

# Optional: HTTPS deployment uses secure cookies automatically in production.
# See README.md for deployment and consent requirements.

# URL checker: use installed Google Chrome, or set chromium after running
# npx playwright install chromium. HTTP/API checks do not need a browser.
CHECK_BROWSER_CHANNEL=chrome
